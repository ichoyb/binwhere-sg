# Copy to .env.local (gitignored) for local runs. On EAS, define these as
# project environment variables per environment instead — never commit values.

# --- Public: inlined into the JS bundle at build time, safe to expose ---
# Optional API override; defaults to production.
EXPO_PUBLIC_API_BASE_URL=https://binwhere.sg
# development | preview | production. Production requires crash reporting.
EXPO_PUBLIC_APP_ENV=development
# Sentry DSN (write-only key). Empty = crash reporting OFF, which app.config.ts
# refuses for production builds.
EXPO_PUBLIC_SENTRY_DSN=

# --- Build-time only: read by app.config.ts / config plugins, never bundled ---
# Sentry org + project slugs; both must be set for the Sentry plugin to be
# added (native symbol + source-map upload).
SENTRY_ORG=
SENTRY_PROJECT=
# EAS secret. Used by the upload build phases only.
SENTRY_AUTH_TOKEN=
# Android maps only.
GOOGLE_MAPS_API_KEY=
