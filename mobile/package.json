{
  "name": "binwhere-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "export:android": "expo export --platform android",
    "export:ios": "expo export --platform ios",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx src/api/client.test.ts && tsx src/lib/history.test.ts && tsx src/lib/core-smoke.test.ts && tsx src/lib/scrub.test.ts && tsx ../packages/core/scripts/next-action.test.ts && tsx ../packages/core/scripts/v1-contract.ts --check",
    "test:live": "tsx src/api/classify-live.test.ts",
    "eas-build-pre-install": "npm ci --prefix ../packages/core"
  },
  "dependencies": {
    "@binwhere/core": "file:../packages/core",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~8.28.0",
    "expo": "~58.0.19",
    "expo-camera": "~58.0.12",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.19",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "~19.3.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  },
  "allowScripts": {
    "@sentry/cli@2.58.6": true,
    "@sentry/cli@3.8.0": true,
    "esbuild@0.27.2": true,
    "fsevents": false
  }
}
