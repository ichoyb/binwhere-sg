{
  "name": "binwhere-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "export:android": "expo export --platform android",
    "export:ios": "expo export --platform ios",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx src/api/client.test.ts && tsx src/lib/history.test.ts && tsx src/lib/core-smoke.test.ts && tsx src/lib/scrub.test.ts && tsx ../packages/core/scripts/v1-contract.ts --check",
    "test:live": "tsx src/api/classify-live.test.ts"
  },
  "dependencies": {
    "@binwhere/core": "file:../packages/core",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.11.0",
    "expo": "~57.0.19",
    "expo-camera": "~57.0.4",
    "expo-haptics": "~57.0.2",
    "expo-image-manipulator": "~57.0.15",
    "expo-localization": "~57.0.1",
    "expo-location": "~57.0.15",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "~19.2.2",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  },
  "allowScripts": {
    "@sentry/cli@2.58.4": true,
    "esbuild@0.27.2": true,
    "fsevents": false
  }
}
