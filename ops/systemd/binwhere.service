[Unit]
Description=BinWhere Web
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=binwhere
Group=binwhere
WorkingDirectory=/opt/binwhere/current/app
EnvironmentFile=/etc/binwhere/env
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3100
ExecStart=/usr/local/bin/node server.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
# Next.js exits 143 (128 + SIGTERM) after a graceful shutdown; without this every
# planned stop, including each deploy restart, is recorded as a failed unit.
SuccessExitStatus=143
UMask=0027

CapabilityBoundingSet=
LockPersonality=true
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=full
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
